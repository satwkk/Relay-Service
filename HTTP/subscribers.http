@baseUrl = http://localhost:8080
# Replace this with the id returned by the registration request.
@subscriberId = 1
@webhookUrl = http://payments/webhooks

### Register a subscriber
POST {{baseUrl}}/subscribers
Content-Type: application/json

{
  "name": "payments",
  "webhook_url": "{{webhookUrl}}",
  "enabled": true
}

### List subscribers
GET {{baseUrl}}/subscribers?limit=100&offset=0

### Get a subscriber
GET {{baseUrl}}/subscribers/{{subscriberId}}

### Update a subscriber (PUT requires name and webhook_url)
PUT {{baseUrl}}/subscribers/{{subscriberId}}
Content-Type: application/json

{
  "name": "payments",
  "webhook_url": "{{webhookUrl}}",
  "enabled": true
}

### Disable a subscriber
PUT {{baseUrl}}/subscribers/{{subscriberId}}
Content-Type: application/json

{
  "name": "payments",
  "webhook_url": "{{webhookUrl}}",
  "enabled": false
}

### Delete a subscriber and all its subscriptions
DELETE {{baseUrl}}/subscribers/{{subscriberId}}
